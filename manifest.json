{
	"description": "Create and load tab groups",
	"manifest_version": 3,
	"name": "Tab Groupinator",
	"version": "1.0.0",
	"homepage_url": "https://github.com/MM4096/tab-groupinator",
	"icons": {
		"48": "icons/tab-groupinator-48.png"
	},
	"permissions": [
		"tabs",
		"storage"
	],
	"action": {
		"default_icon": "icons/tab-groupinator-48.png",
		"default_title": "Tab Groupinator",
		"default_popup": "popup/main_popup.html"
	},

	"browser_specific_settings": {
		"gecko": {
			"id": "tab-groupinator@mm4096.com",
			"data_collection_permissions": {
				"required": []
			}
		}
	}
}
